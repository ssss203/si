    "appId": "com.si.pet",
    "version": "1.0.0",
    "language": "zh-CN"
  },
  "targets": {
    "windows": {
      "enabled": true,
      "arch": "x64"
    },
    "macos": {
      "enabled": false,
      "arch": "current"
    }
  },
  "character": {
    "inputType": "single-image",
    "coreAsset": "core-ip/core-ip.png",
    "displayName": "肆",
    "archetype": "robot",
    "personality": [
      "毒舌",
      "硬核",
      "靠谱",
      "电波系"
    ],
    "preserveTraits": [
      "米白圆润身形",
      "银色天线",
      "黑银耳机耳",
      "橙色领巾",
      "胸前红色肆字徽章",
      "黑色滑轮脚",
      "俏皮单眼眨眼",
      "双手叉腰"
    ],
    "style": "preserve",
    "mirrorSafe": false
