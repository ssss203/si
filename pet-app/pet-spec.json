    "interactions": [
      {
        "id": "charge",
        "emoji": "🔌",
        "label": "充电",
        "stateId": "charge",
        "durationMs": 2200,
        "affectionGain": 5,
        "feedback": [
          "别催，充完我满血复活，等着被我怼吧。",
          "电量+1，脑子清楚了嘛。",
          "充好了，赶紧给我安排活儿。"
        ]
      },
      {
        "id": "music",
        "emoji": "🎧",
        "label": "听歌",
        "stateId": "music",
        "durationMs": 2000,
        "affectionGain": 3,
        "feedback": [
          "耳机一戴，谁都不爱。",
          "别偷看我歌单嘛。",
          "这节奏，比你的方案靠谱。"
        ]
      },
      {
        "id": "pet-head",
        "emoji": "🫳",
        "label": "摸头",
        "stateId": "pet",
        "durationMs": 1600,
        "affectionGain": 4,
        "feedback": [
          "行了行了，就一下嘛。",
          "摸头能涨好感？天真。",
          "行吧，勉强让你摸一下。"
        ]
      },
      {
        "id": "badge",
        "emoji": "✨",
        "label": "认亲",
        "stateId": "badge",
        "durationMs": 1800,
        "affectionGain": 3,
        "feedback": [
          "看清楚，我是肆，不是四。",
          "放肆的肆，记住了嘛。",
          "徽章亮着呢，别认错人。"
        ]
      }
    ]
  },
  "motion": {
